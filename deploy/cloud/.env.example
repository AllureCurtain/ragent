COMPOSE_PROJECT_NAME=ragent-cloud
RAGENT_IMAGE_TAG=local
RAGENT_BACKEND_IMAGE=ragent-backend
RAGENT_MCP_IMAGE=ragent-mcp-server
RAGENT_WEB_IMAGE=ragent-web
RAGENT_JAVA_DOCKERFILE=deploy/cloud/Dockerfile
RAGENT_FRONTEND_DOCKERFILE=deploy/cloud/frontend.Dockerfile
TZ=Asia/Shanghai

# The web container binds to loopback so the host Nginx/Caddy remains the only public entry point.
RAGENT_BIND_ADDRESS=127.0.0.1
RAGENT_HTTP_PORT=19080
RAGENT_PUBLIC_ORIGIN=https://rag.785777.xyz

# Existing Docker network shared with PostgreSQL and RustFS.
RAGENT_INFRA_NETWORK=ragent-infra
ROCKETMQ_NETWORK=rocketmq_rmq-net
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_POOL_MAX_SIZE=5
POSTGRES_POOL_MIN_IDLE=1

RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_UPSTREAM=rustfs:9000
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
RUSTFS_REGION=us-east-1
RUSTFS_PUBLIC_URL=https://rag.785777.xyz/storage
RAGENT_SOURCE_BUCKET=ragent-demo-sources
RAGENT_ASSET_BUCKET=ragent-demo-assets

# Point these at existing services, or start compose.infra.yaml.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
ROCKETMQ_NAME_SERVER=rmq-namesrv:9876

# Required model providers for the cloud profile.
BAILIAN_API_KEY=CHANGE_ME
SILICONFLOW_API_KEY=CHANGE_ME

# Optional providers/features. Empty values are allowed.
AIHUBMIX_API_KEY=
MINERU_API_KEY=
YDC_API_KEY=

APP_DEMO_MODE=false
RAGENT_UNIQUE_NAME=-cloud
RAGENT_MAX_CONCURRENT=2
RAGENT_MAX_WAIT_SECONDS=15

BACKEND_JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:MaxMetaspaceSize=192m -XX:MaxDirectMemorySize=64m -Xss512k -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8
MCP_JAVA_TOOL_OPTIONS=-Xms64m -Xmx160m -XX:MaxMetaspaceSize=128m -XX:MaxDirectMemorySize=32m -Xss512k -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8
BACKEND_MEMORY_LIMIT=768m
MCP_MEMORY_LIMIT=256m
WEB_MEMORY_LIMIT=64m
REDIS_MEMORY_LIMIT=96m
